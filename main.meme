# main.meme -- sheet CLI. Thin argv router only; all domain logic lives in
# the cells, formula, and sheet modules.
#
# Errors: one line to stderr via `print error`, exit 1.
use cells
use formula
use sheet

function report_error(msg: String) -> Void:
    print error msg

function print_usage() -> Void:
    print error "Usage: sheet <command> [args]"
    print error "  sheet set <cell> <formula>   # formula: <int> | <cell> | <cell> +|-|* <cell|int> | SUM/AVG/MIN/MAX(A1:A5)"
    print error "  sheet get <cell>             # evaluated value"
    print error "  sheet display                # grid dump of populated cells"
    print error "  sheet deps <cell>            # direct dependencies, sorted"
    print error "  sheet dependents <cell>      # reverse dependencies, sorted"
    print error "  sheet eval-order             # topological order of populated cells"

define data_path as "data/sheet.json"

if argument count < 2:
    call print_usage()
    exit with code 1

define cmd as argument 1
define cells as load_cells(data_path)

if cmd == "set":
    if argument count != 4:
        call report_error("usage: sheet set <cell> <formula>")
        exit with code 1
    define cell_name as argument 2
    define ftext as argument 3
    if parse_cell(cell_name) is nothing:
        call report_error("Error: invalid cell " + cell_name)
        exit with code 1
    define fopt as parse_formula(ftext)
    if fopt is nothing:
        call report_error("Error: invalid formula for " + cell_name)
        exit with code 1
    define f as value of fopt
    define refs as formula_refs(f)
    if would_cycle(cells, cell_name, refs):
        # rejected set: nothing is applied or saved, the sheet is unchanged
        call report_error("Error: cycle detected at " + cell_name)
        exit with code 1
    set cells to apply_set(cells, cell_name, ftext)
    create directory "data"
    call save_cells(cells, data_path)
    print cell_name + " = " + ftext
    exit with code 0

if cmd == "get":
    if argument count != 3:
        call report_error("usage: sheet get <cell>")
        exit with code 1
    define cell_name as argument 2
    if parse_cell(cell_name) is nothing:
        call report_error("Error: invalid cell " + cell_name)
        exit with code 1
    define visiting as empty List<String>
    define v as eval_cell(cells, cell_name, visiting)
    print text of v
    exit with code 0

if cmd == "display":
    if argument count != 2:
        call report_error("usage: sheet display")
        exit with code 1
    define lines as display_lines(cells)
    for each ln in lines:
        print ln
    exit with code 0

if cmd == "deps":
    if argument count != 3:
        call report_error("usage: sheet deps <cell>")
        exit with code 1
    define cell_name as argument 2
    if parse_cell(cell_name) is nothing:
        call report_error("Error: invalid cell " + cell_name)
        exit with code 1
    define ds as deps_of(cells, cell_name)
    for each d in ds:
        print d
    exit with code 0

if cmd == "dependents":
    if argument count != 3:
        call report_error("usage: sheet dependents <cell>")
        exit with code 1
    define cell_name as argument 2
    if parse_cell(cell_name) is nothing:
        call report_error("Error: invalid cell " + cell_name)
        exit with code 1
    define rs as dependents_of(cells, cell_name)
    for each r in rs:
        print r
    exit with code 0

if cmd == "eval-order":
    if argument count != 2:
        call report_error("usage: sheet eval-order")
        exit with code 1
    define result as topo_order(cells)
    if result.ok:
        define order as result.order
        for each nm in order:
            print nm
        exit with code 0
    call report_error("Error: cycle detected at " + result.stuck)
    exit with code 1

call print_usage()
exit with code 1
